---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/Navbar.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PdfConverterIsland from '@/components/PdfConverterIsland';
import SeoContentSection from '@/components/SeoContentSection.astro';
import Footer from '@/components/Footer.astro';
import { SUPPORTED_LANGUAGES, getDictionary, type LangCode } from '@/i18n/config';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.filter((l) => l.code !== 'en').map((l) => ({
    params: { lang: l.code }
  }));
}

const { lang } = Astro.params as { lang: LangCode };
const dict = getDictionary(lang);
---

<Layout lang={lang}>
  <Navbar lang={lang} />
  <main id="main-content" class="flex-1">
    <Breadcrumbs lang={lang} />
    <PdfConverterIsland client:load dict={dict} />
    <SeoContentSection lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
